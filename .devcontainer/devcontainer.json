{
  "name": "ruby-dev",
  "build": {
    "dockerfile": "../dev/Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "root",
  "forwardPorts": [
    3000,
    3007,
    3010,
    3011, 
    8233
  ],
  "runArgs": [
    "--init"
  ],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "remoteEnv": {
    "RUBY_IN_CONTAINER": "1",
    "OP_SERVICE_ACCOUNT_TOKEN": "${localEnv:OP_SERVICE_ACCOUNT_TOKEN}",
    "OP_ENVIRONMENT_ID": "${localEnv:OP_ENVIRONMENT_ID}",
    "DEV_WORKOS_USER_EMAIL": "${localEnv:DEV_WORKOS_USER_EMAIL}",
    "DEV_WORKOS_USER_ID": "${localEnv:DEV_WORKOS_USER_ID}",
    "DEV_WORKOS_USER_PASSWORD": "${localEnv:DEV_WORKOS_USER_PASSWORD}",
    "SHELL": "/bin/zsh",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    "source=ruby-dev-node-modules,target=/workspace/node_modules,type=volume",
    "source=ruby-dev-cargo-target,target=/workspace/core/target,type=volume",
    "source=ruby-dev-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=ruby-dev-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=ruby-dev-front-spa-vite,target=/workspace/front-spa/.vite,type=volume",
    "source=ruby-dev-front-api-cache,target=/workspace/front-api/.cache,type=volume",
    "source=ruby-dev-front-api-dist,target=/workspace/front-api/dist,type=volume",
    "source=ruby-dev-ui-dist,target=/workspace/ui/dist,type=volume",
    "source=ruby-dev-data,target=/var/lib/ruby-dev,type=volume",
    "source=ruby-dev-gcloud-config,target=/root/.config/gcloud,type=volume",
    "source=ruby-dev-git-spice-config,target=/root/.config/git-spice,type=volume",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],
  "postCreateCommand": "bash dev/scripts/install.sh",
  "postStartCommand": "RUBY_OFFER_START_APPS=1 bash dev/scripts/infra.sh",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "rust-lang.rust-analyzer",
        "typescriptteam.native-preview",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens"
      ],
      "settings": {
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh",
            "args": [
              "-l"
            ]
          }
        }
      }
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Api"
    },
    "3007": {
      "label": "Viz"
    },
    "3010": {
      "label": "Admin"
    },
    "3011": {
      "label": "App"
    },
    "8233": {
      "label": "Temporal"
    }
  }
}