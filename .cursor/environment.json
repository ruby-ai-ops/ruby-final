{
  "name": "ruby-ai/ruby",
  "build": {
    "dockerfile": "../dev/Dockerfile",
    "context": ".."
  },
  "install": "bash dev/scripts/install.sh",
  "start": "bash dev/scripts/infra.sh",
  "terminals": [
    {
      "name": "mprocs",
      "command": "bash dev/scripts/apps.sh",
      "description": "Dev stack via mprocs: sdks-js/ui watches, bacon Rust reload, all services"
    }
  ],
  "ports": [
    { "name": "front-api", "port": 3000 },
    { "name": "front-admin", "port": 3010 },
    { "name": "front-spa", "port": 3011 },
    { "name": "viz", "port": 3007 },
    { "name": "temporal-ui", "port": 8233 }
  ]
}
