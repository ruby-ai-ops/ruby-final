{
  "name": "@ruby-ai/marketing-workspace-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:verify": "node --test tests/assets.test.mjs tests/adapter-styles.test.mjs",
    "source:verify": "node --test ../tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:adapter": "vitest run --config vitest.config.ts",
    "test:upstream": "npm --prefix ../upstream test",
    "test": "npm run source:verify && npm run assets:verify && npm run typecheck && npm run test:adapter && npm run test:upstream",
    "build": "npm run source:verify && npm run assets:verify && node scripts/prepare-public.mjs && vite build && npm run build:verify",
    "build:verify": "node --test tests/build-output.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.0"
  }
}
